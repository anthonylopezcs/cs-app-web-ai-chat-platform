<%# locals: (heading:) -%>
<% branding = GlobalConfig.get('INSTALLATION_NAME', 'LOGO') %>
<% installation_name = branding['INSTALLATION_NAME'].presence || 'Scoops Xi' %>
<% logo = branding['LOGO'].presence || '/brand-assets/logo.png' %>
<!DOCTYPE html>
<html lang="<%= I18n.locale %>" class="h-full">
  <head>
    <meta charset="utf-8">
    <meta name="robots" content="noindex">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= installation_name %></title>
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <%= render "super_admin/application/theme" %>
    <%= render "super_admin/application/font_preload", file: "Inter/InterVariable.woff2" %>
    <%= render "super_admin/application/font_preload", file: "InterDisplay/InterDisplay-SemiBold.woff2" %>
    <%= vite_client_tag %>
    <%= vite_stylesheet_tag 'superadmin.scss' %>
  </head>
  <body class="min-h-full bg-n-background text-n-slate-12 antialiased">
    <div class="fixed inset-x-0 top-0 h-64 bg-pixel-band [mask-image:linear-gradient(to_bottom,black,transparent)]"></div>
    <main class="relative mx-auto flex min-h-screen w-full max-w-md flex-col justify-center px-4 py-10">
      <img src="<%= logo %>" alt="<%= installation_name %>" class="mx-auto size-20">
      <p class="mt-4 text-center font-interDisplay text-2xl font-semibold tracking-tight"><%= installation_name %></p>
      <h1 class="mt-2 text-center text-xl font-medium text-n-slate-11"><%= heading %></h1>
      <div class="rounded-xl border border-n-weak bg-n-solid-1 mt-8 p-6 sm:p-8">
        <% if flash[:error].present? %>
          <%= render "super_admin/application/alert", extra: "mb-4" do %>
            <%= flash[:error] %>
          <% end %>
        <% end %>
        <%= yield %>
      </div>
    </main>
  </body>
</html>
